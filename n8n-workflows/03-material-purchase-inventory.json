{
  "name": "03 - Material Purchase & Inventory",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            { "mode": "everyX", "unit": "hours", "value": 4 }
          ]
        }
      },
      "id": "3a111111-1111-1111-1111-111111111111",
      "name": "Cron - Every 4 Hours",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM inventory WHERE quantity_on_hand < reorder_threshold"
      },
      "id": "3a222222-2222-2222-2222-222222222222",
      "name": "Postgres - Get Low Stock Materials",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{$json[\"has_open_po\"]}}", "value2": false }
          ]
        }
      },
      "id": "3a333333-3333-3333-3333-333333333333",
      "name": "IF - No Open PO Exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "functionCode": "const year = new Date().getFullYear();\nconst seq = String(Math.floor(Math.random()*9000)+1000);\nitems[0].json.po_id = `PO-${year}-${seq}`;\nitems[0].json.total_cost = items[0].json.reorder_quantity * items[0].json.unit_cost;\nreturn items;"
      },
      "id": "3a444444-4444-4444-4444-444444444444",
      "name": "Function - Build PO Number & Total",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [860, 220]
    },
    {
      "parameters": {
        "fromEmail": "procurement@construction-co.com",
        "toEmail": "={{$json[\"supplier_email\"]}}",
        "subject": "Purchase Order {{$json[\"po_id\"]}}"
      },
      "id": "3a555555-5555-5555-5555-555555555555",
      "name": "Send Email - PO to Supplier",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [1080, 220]
    },
    {
      "parameters": {
        "channel": "#procurement",
        "text": "🧾 New PO created: {{$json[\"po_id\"]}} — {{$json[\"material\"]}} x{{$json[\"quantity\"]}} from {{$json[\"supplier_name\"]}}"
      },
      "id": "3a666666-6666-6666-6666-666666666666",
      "name": "Slack - Notify Procurement",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1300, 220]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "purchase_orders"
      },
      "id": "3a777777-7777-7777-7777-777777777777",
      "name": "Postgres - Insert PO (status=pending)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1520, 220]
    },
    {
      "parameters": {
        "path": "delivery-status-update",
        "httpMethod": "POST"
      },
      "id": "3a888888-8888-8888-8888-888888888888",
      "name": "Webhook - Delivery Status Update",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [1740, 220]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{$json[\"status\"]}}", "value2": "delivered" }
          ]
        }
      },
      "id": "3a999999-9999-9999-9999-999999999999",
      "name": "IF - Delivered",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1960, 220]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE inventory SET quantity_on_hand = quantity_on_hand + {{$json[\"quantity\"]}} WHERE material_id = '{{$json[\"material_id\"]}}'"
      },
      "id": "3aaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
      "name": "Postgres - Update Inventory",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [2180, 140]
    },
    {
      "parameters": {
        "fromEmail": "automations@construction-co.com",
        "toEmail": "={{$json[\"supervisor_email\"]}}",
        "subject": "Materials Delivered — {{$json[\"material\"]}}"
      },
      "id": "3abbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
      "name": "Send Email - Notify Supervisor",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [2400, 140]
    },
    {
      "parameters": {
        "channel": "#procurement",
        "text": "⚠️ PO {{$json[\"po_id\"]}} is overdue for delivery. Escalating."
      },
      "id": "3acccccc-cccc-cccc-cccc-cccccccccccc",
      "name": "Slack - Escalate Overdue Delivery",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [2180, 300]
    }
  ],
  "connections": {
    "Cron - Every 4 Hours": {
      "main": [[{ "node": "Postgres - Get Low Stock Materials", "type": "main", "index": 0 }]]
    },
    "Postgres - Get Low Stock Materials": {
      "main": [[{ "node": "IF - No Open PO Exists", "type": "main", "index": 0 }]]
    },
    "IF - No Open PO Exists": {
      "main": [
        [{ "node": "Function - Build PO Number & Total", "type": "main", "index": 0 }],
        []
      ]
    },
    "Function - Build PO Number & Total": {
      "main": [[{ "node": "Send Email - PO to Supplier", "type": "main", "index": 0 }]]
    },
    "Send Email - PO to Supplier": {
      "main": [[{ "node": "Slack - Notify Procurement", "type": "main", "index": 0 }]]
    },
    "Slack - Notify Procurement": {
      "main": [[{ "node": "Postgres - Insert PO (status=pending)", "type": "main", "index": 0 }]]
    },
    "Postgres - Insert PO (status=pending)": {
      "main": [[{ "node": "Webhook - Delivery Status Update", "type": "main", "index": 0 }]]
    },
    "Webhook - Delivery Status Update": {
      "main": [[{ "node": "IF - Delivered", "type": "main", "index": 0 }]]
    },
    "IF - Delivered": {
      "main": [
        [{ "node": "Postgres - Update Inventory", "type": "main", "index": 0 }],
        [{ "node": "Slack - Escalate Overdue Delivery", "type": "main", "index": 0 }]
      ]
    },
    "Postgres - Update Inventory": {
      "main": [[{ "node": "Send Email - Notify Supervisor", "type": "main", "index": 0 }]]
    }
  }
}
